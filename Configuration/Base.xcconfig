#include "Version.xcconfig"

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = $(inherited)
CODE_SIGNING_ALLOWED = YES
CODE_SIGNING_REQUIRED = YES
CODE_SIGNING_SUPPORTED = YES
PRODUCT_BUNDLE_IDENTIFIER = com.aapl.relaxin
PROVISIONING_PROFILE_SPECIFIER =
IPHONEOS_DEPLOYMENT_TARGET = 16.5
RELAXIN_BASEBIN_DEPLOYMENT_TARGET = 16.5

// System frameworks used by the app target (auto-linking is enabled, but
// keeping them explicit avoids surprises in lite/overlay builds).
OTHER_LDFLAGS = $(inherited) -framework AVFoundation -framework Photos -framework PhotosUI

// arm64e only — do not add arm64 back
// simulator support is removed
ARCHS = arm64e

#include? "_Local.xcconfig"
